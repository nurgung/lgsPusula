# Copy to .env.local for local development. Never commit real values.
# Variables WITHOUT the NEXT_PUBLIC_ prefix stay on the server.
# Variables WITH the NEXT_PUBLIC_ prefix are inlined into the browser bundle at build time;
# never put secrets in them.

# Public app URL; use the correct value per environment.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Deployment environment: development | test | staging | production
APP_ENV=development

# Enables /onizleme UI drafts with fictional sample data. Read at build time.
# Rejected when APP_ENV=production. These pages have NO authentication.
UI_PREVIEW_ENABLED=false

# Local backup/restore (phase 12). Leave empty to use the local Supabase database.
# Never commit a production URL. The backup script encrypts the dump.
DATABASE_URL=

# Auth (Supabase, decision 0.1). Set all four or none; a partial set fails at startup.
# Local: run `npm run db:start`, then copy API_URL / ANON_KEY / SERVICE_ROLE_KEY from
# `npx supabase status`. Staging/production: values of that environment's own project.
# SUPABASE_SERVICE_ROLE_KEY bypasses RLS: server and setup script only, never NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# HMAC key for rate-limit counters (usernames/IPs are never stored in plain text).
# At least 32 characters, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`
AUTH_SECRET=
# Optional. HMAC key for family invite code hashes in the database. Use the SAME value on
# every environment that shares one Supabase project (production, preview, local-against-prod).
# If empty, AUTH_SECRET is used (preview and production must then share AUTH_SECRET too).
FAMILY_INVITE_SECRET=

# Error monitoring (Sentry, decision 0.9). Server only. Empty disables reporting.
# EU ingest only, for example https://<key>@o<org>.ingest.de.sentry.io/<project>
# In the Sentry project: sendDefaultPii off, session replay off, retention 30 days.
SENTRY_DSN=

# AI provider settings; server-side only (Groq, Phase 13).
# Leave AI_ENABLED false until the owner turns on zero data retention in the Groq
# console and sets AI_ZDR_CONFIRMED=true. The student switch is a second off switch.
# AI_MODEL must stay empty or llama-3.3-70b-versatile. Never use NEXT_PUBLIC_ here.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
AI_ENABLED=false
AI_ZDR_CONFIRMED=false
AI_DAILY_REQUEST_LIMIT=20

# Object storage / reporting settings if required.
STORAGE_BUCKET=
REPORT_TEMP_TTL_MINUTES=30
