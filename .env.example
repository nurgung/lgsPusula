# Copy to .env.local for local development. Never commit real values.
# Variables WITHOUT the NEXT_PUBLIC_ prefix stay on the server.
# Variables WITH the NEXT_PUBLIC_ prefix are inlined into the browser bundle at build time;
# never put secrets in them.

# Public app URL; use the correct value per environment.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Deployment environment: development | test | staging | production
APP_ENV=development

# Enables /onizleme UI drafts with fictional sample data. Read at build time.
# Rejected when APP_ENV=production. These pages have NO authentication.
UI_PREVIEW_ENABLED=false

# Server-only database/auth provider settings (provider not chosen yet).
# Fill with provider-specific values locally; never commit real credentials.
DATABASE_URL=
AUTH_SECRET=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI provider settings; server-side only (provider not chosen yet).
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

# Object storage / reporting settings if required.
STORAGE_BUCKET=
REPORT_TEMP_TTL_MINUTES=30
